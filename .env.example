# Скопируйте этот файл как .env (он уже называется .env) и заполните значения.
DATASET_API_URL=ВСТАВЬТЕ_ССЫЛКУ_DEV_ОТ_ОРГАНИЗАТОРОВ
# Ключ OpenAI используется и для Whisper, и для оценки диалогов.
OPENAI_API_KEY=
# При необходимости можно отдельно использовать OpenRouter для оценки:
OPENROUTER_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Модель оценки при использовании OpenRouter (любая из https://openrouter.ai/models).
OPENROUTER_MODEL=openai/gpt-4.1-mini
PORT=3000
